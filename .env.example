# ==========================================================
# Grade 8 Hub - environment configuration
# Copy this file to ".env" and change the values.
#   Windows : copy .env.example .env
#   macOS/Linux : cp .env.example .env
# ==========================================================

# Port the web application listens on.
PORT=3000

# Secret used to sign login sessions.
# CHANGE THIS to a long random string before real use.
JWT_SECRET=change-this-to-a-long-random-secret-string

# How long a login stays valid.
SESSION_DAYS=14

# Where the SQLite database file is stored.
DATABASE_FILE=./database/grade8hub.db

# Folder for uploaded images and homework attachments.
UPLOAD_DIR=./uploads

# Max upload size in megabytes.
MAX_UPLOAD_MB=8

# The first administrator account, created automatically on first run.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Grade8Admin!
ADMIN_DISPLAY_NAME=Head Administrator
ADMIN_EMAIL=admin@grade8hub.local

# Fill the database with example students, clubs, posts and homework
# the first time the app starts. Set to false for a clean, empty community.
SEED_DEMO_DATA=true

# Set to "production" when hosting the app for real.
NODE_ENV=development
