# ==========================================================
# Coding Hub - configuration
# Copy this file to .env and change what you need.
# ==========================================================

PORT=4000
NODE_ENV=development

# Sign-in sessions are signed with this. Change it before hosting for real.
JWT_SECRET=change-this-to-a-long-random-secret-string
SESSION_DAYS=14

DATABASE_FILE=./database/codinghub.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# The first administrator, created on the very first start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CodingHub!2026
ADMIN_DISPLAY_NAME=Site Owner
ADMIN_EMAIL=admin@codinghub.local

# Adds a few example learners to look at. Off by default.
SEED_DEMO_DATA=false
