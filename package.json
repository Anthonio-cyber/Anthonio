{
  "name": "grade8-hub",
  "version": "1.2.0",
  "private": true,
  "description": "Grade 8 Hub - a private community, messaging, gaming, homework and club platform for one Grade 8 class.",
  "type": "module",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "node scripts/setup.js && node --watch server/index.js",
    "start": "node scripts/setup.js && node server/index.js",
    "build": "node scripts/build.js",
    "seed": "node server/db/seed.js",
    "reset-db": "node scripts/reset-db.js",
    "create-admin": "node scripts/create-admin.js",
    "app": "electron desktop/main.js",
    "app:setup": "npm install --no-save --no-audit --no-fund electron@^33.0.0 electron-builder@^25.0.0",
    "app:build": "electron-builder --publish never",
    "app:build:win": "electron-builder --win --publish never",
    "app:build:mac": "electron-builder --mac --publish never",
    "app:build:linux": "electron-builder --linux --publish never",
    "app:rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nanoid": "^5.0.7",
    "socket.io": "^4.7.5"
  },
  "build": {
    "appId": "local.grade8hub.app",
    "productName": "Grade 8 Hub",
    "copyright": "Grade 8 Hub",
    "directories": {
      "output": "dist-app",
      "buildResources": "public/icons"
    },
    "files": [
      "desktop/**/*",
      "server/**/*",
      "client/**/*",
      "public/**/*",
      "scripts/**/*",
      ".env.example",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon-256.png",
      "artifactName": "Grade8Hub-Setup-${version}-windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Grade 8 Hub"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icons/icon-512.png",
      "category": "public.app-category.education",
      "artifactName": "Grade8Hub-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icons/icon-512.png",
      "category": "Education",
      "maintainer": "Anthonio <anthonio@users.noreply.github.com>",
      "artifactName": "Grade8Hub-${version}-linux.${ext}"
    },
    "asar": false,
    "npmRebuild": true
  },
  "author": {
    "name": "Anthonio",
    "email": "anthonio@users.noreply.github.com"
  },
  "license": "MIT"
}
